#:kivy 2.3.1

#:import MDCard kivymd.uix.card.MDCard
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import BottomNav widget.bottom_nav.BottomNav


<AnalyticsScreen>:

    BoxLayout:
        orientation: "vertical"

        # =====================================================
        # MAIN BACKGROUND
        # =====================================================

        canvas.before:
            Color:
                rgba: (0.06, 0.06, 0.08, 1) if app.theme_cls.theme_style == "Dark" else (0.96, 0.97, 1, 1)

            Rectangle:
                pos: self.pos
                size: self.size


        # =====================================================
        # HEADER
        # =====================================================

        MDCard:
            size_hint_y: None
            height: "105dp"

            radius: [0, 0, 28, 28]

            elevation: 0

            md_bg_color: 0.10, 0.32, 0.82, 1

            BoxLayout:
                orientation: "vertical"

                padding: "20dp", "14dp"

                Label:
                    text: "Analytics"

                    font_size: "28sp"
                    bold: True

                    color: 1, 1, 1, 1

                    halign: "left"
                    valign: "middle"

                    text_size: self.size


                Label:
                    text: "Understand where your money goes"

                    font_size: "13sp"

                    color: 0.88, 0.92, 1, 1

                    halign: "left"
                    valign: "middle"

                    text_size: self.size


        # =====================================================
        # CONTENT
        # =====================================================

        ScrollView:

            do_scroll_x: False

            bar_width: "4dp"

            BoxLayout:

                orientation: "vertical"

                size_hint_y: None

                height: self.minimum_height

                padding: "14dp"

                spacing: "14dp"


                # =================================================
                # FINANCIAL OVERVIEW
                # =================================================

                Label:
                    text: "Financial Overview"

                    font_size: "19sp"

                    bold: True

                    color: (0.95, 0.95, 0.97, 1) if app.theme_cls.theme_style == "Dark" else (0.12, 0.14, 0.20, 1)

                    halign: "left"

                    text_size: self.width, None

                    size_hint_y: None

                    height: "30dp"


                BoxLayout:

                    orientation: "horizontal"

                    spacing: "10dp"

                    size_hint_y: None

                    height: "105dp"


                    # =================================================
                    # BALANCE
                    # =================================================

                    MDCard:

                        radius: [15, 15, 15, 15]

                        elevation: 2

                        md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        BoxLayout:

                            orientation: "vertical"

                            padding: "12dp"

                            spacing: "3dp"


                            Label:
                                text: "Balance"

                                font_size: "12sp"

                                bold: True

                                color: (0.65, 0.67, 0.73, 1) if app.theme_cls.theme_style == "Dark" else (0.35, 0.38, 0.45, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "22dp"


                            Label:
                                id: balance_label

                                text: "₹0.00"

                                font_size: "20sp"

                                bold: True

                                color: 0.10, 0.75, 0.35, 1

                                halign: "left"

                                valign: "middle"

                                text_size: self.size


                            Label:
                                text: "Current"

                                font_size: "10sp"

                                color: (0.55, 0.57, 0.63, 1) if app.theme_cls.theme_style == "Dark" else (0.50, 0.52, 0.58, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "18dp"


                    # =================================================
                    # TRANSACTIONS
                    # =================================================

                    MDCard:

                        radius: [15, 15, 15, 15]

                        elevation: 2

                        md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        BoxLayout:

                            orientation: "vertical"

                            padding: "12dp"

                            spacing: "3dp"


                            Label:
                                text: "Transactions"

                                font_size: "12sp"

                                bold: True

                                color: (0.65, 0.67, 0.73, 1) if app.theme_cls.theme_style == "Dark" else (0.35, 0.38, 0.45, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "22dp"


                            Label:
                                id: transaction_count_label

                                text: "0"

                                font_size: "22sp"

                                bold: True

                                color: (0.25, 0.55, 1, 1)

                                halign: "left"

                                valign: "middle"

                                text_size: self.size


                            Label:
                                text: "Recorded"

                                font_size: "10sp"

                                color: (0.55, 0.57, 0.63, 1) if app.theme_cls.theme_style == "Dark" else (0.50, 0.52, 0.58, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "18dp"


                    # =================================================
                    # CATEGORIES
                    # =================================================

                    MDCard:

                        radius: [15, 15, 15, 15]

                        elevation: 2

                        md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        BoxLayout:

                            orientation: "vertical"

                            padding: "12dp"

                            spacing: "3dp"


                            Label:
                                text: "Categories"

                                font_size: "12sp"

                                bold: True

                                color: (0.65, 0.67, 0.73, 1) if app.theme_cls.theme_style == "Dark" else (0.35, 0.38, 0.45, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "22dp"


                            Label:
                                id: category_count_label

                                text: "0"

                                font_size: "22sp"

                                bold: True

                                color: (0.25, 0.55, 1, 1)

                                halign: "left"

                                valign: "middle"

                                text_size: self.size


                            Label:
                                text: "Expense types"

                                font_size: "10sp"

                                color: (0.55, 0.57, 0.63, 1) if app.theme_cls.theme_style == "Dark" else (0.50, 0.52, 0.58, 1)

                                halign: "left"

                                text_size: self.width, None

                                size_hint_y: None

                                height: "18dp"


                # =================================================
                # FINANCIAL INSIGHTS
                # =================================================

                MDCard:

                    size_hint_y: None

                    height: "235dp"

                    radius: [20, 20, 20, 20]

                    elevation: 3

                    md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                    BoxLayout:

                        orientation: "vertical"

                        padding: "18dp"

                        spacing: "10dp"


                        Label:
                            text: "Financial Insights"

                            font_size: "20sp"

                            bold: True

                            color: (0.95, 0.95, 0.97, 1) if app.theme_cls.theme_style == "Dark" else (0.12, 0.14, 0.20, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "30dp"


                        Label:
                            text: "A quick look at your financial health"

                            font_size: "12sp"

                            color: (0.60, 0.62, 0.68, 1) if app.theme_cls.theme_style == "Dark" else (0.45, 0.48, 0.55, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "20dp"


                        # =========================================
                        # INCOME / EXPENSE / SAVINGS
                        # =========================================

                        BoxLayout:

                            spacing: "8dp"

                            size_hint_y: None

                            height: "72dp"


                            MDCard:

                                radius: [12, 12, 12, 12]

                                elevation: 0

                                md_bg_color: (0.03, 0.20, 0.08, 1) if app.theme_cls.theme_style == "Dark" else (0.90, 0.98, 0.92, 1)

                                BoxLayout:

                                    orientation: "vertical"

                                    padding: "10dp"


                                    Label:
                                        text: "Income"

                                        font_size: "11sp"

                                        bold: True

                                        color: 0.10, 0.75, 0.35, 1

                                        halign: "left"

                                        text_size: self.width, None

                                        size_hint_y: None

                                        height: "20dp"


                                    Label:
                                        id: total_income_label

                                        text: "₹0.00"

                                        font_size: "16sp"

                                        bold: True

                                        color: 0.10, 0.75, 0.35, 1

                                        halign: "left"

                                        text_size: self.width, None


                            MDCard:

                                radius: [12, 12, 12, 12]

                                elevation: 0

                                md_bg_color: (0.28, 0.05, 0.05, 1) if app.theme_cls.theme_style == "Dark" else (1, 0.92, 0.92, 1)

                                BoxLayout:

                                    orientation: "vertical"

                                    padding: "10dp"


                                    Label:
                                        text: "Expenses"

                                        font_size: "11sp"

                                        bold: True

                                        color: 1, 0.20, 0.20, 1

                                        halign: "left"

                                        text_size: self.width, None

                                        size_hint_y: None

                                        height: "20dp"


                                    Label:
                                        id: total_expense_label

                                        text: "₹0.00"

                                        font_size: "16sp"

                                        bold: True

                                        color: 1, 0.20, 0.20, 1

                                        halign: "left"

                                        text_size: self.width, None


                            MDCard:

                                radius: [12, 12, 12, 12]

                                elevation: 0

                                md_bg_color: (0.06, 0.10, 0.25, 1) if app.theme_cls.theme_style == "Dark" else (0.92, 0.95, 1, 1)

                                BoxLayout:

                                    orientation: "vertical"

                                    padding: "10dp"


                                    Label:
                                        text: "Savings Rate"

                                        font_size: "11sp"

                                        bold: True

                                        color: 0.25, 0.55, 1, 1

                                        halign: "left"

                                        text_size: self.width, None

                                        size_hint_y: None

                                        height: "20dp"


                                    Label:
                                        id: savings_rate_label

                                        text: "0.0%"

                                        font_size: "16sp"

                                        bold: True

                                        color: 0.25, 0.55, 1, 1

                                        halign: "left"

                                        text_size: self.width, None


                        # =========================================
                        # HIGHEST SPENDING
                        # =========================================

                        MDCard:

                            size_hint_y: None

                            height: "48dp"

                            radius: [12, 12, 12, 12]

                            elevation: 0

                            md_bg_color: (0.15, 0.15, 0.20, 1) if app.theme_cls.theme_style == "Dark" else (0.95, 0.96, 0.98, 1)

                            BoxLayout:

                                padding: "10dp"

                                spacing: "10dp"


                                Label:
                                    text: "Highest Spending"

                                    font_size: "12sp"

                                    bold: True

                                    color: (0.80, 0.80, 0.84, 1) if app.theme_cls.theme_style == "Dark" else (0.30, 0.32, 0.38, 1)

                                    halign: "left"

                                    valign: "middle"

                                    text_size: self.size


                                Label:
                                    id: insight_category_label

                                    text: "No Expenses"

                                    font_size: "13sp"

                                    bold: True

                                    color: 0.25, 0.55, 1, 1

                                    halign: "right"

                                    valign: "middle"

                                    text_size: self.size


                                Label:
                                    id: insight_category_amount

                                    text: "₹0.00"

                                    font_size: "13sp"

                                    bold: True

                                    color: 1, 0.20, 0.20, 1

                                    halign: "right"

                                    valign: "middle"

                                    text_size: self.size


                # =================================================
                # AI FINANCIAL ADVISOR
                # =================================================

                MDCard:

                    size_hint_y: None

                    height: "190dp"

                    radius: [20, 20, 20, 20]

                    elevation: 4

                    md_bg_color: (0.10, 0.11, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                    # AI CARD BORDER

                    canvas.before:

                        Color:

                            rgba: (0.25, 0.55, 1, 0.65) if app.theme_cls.theme_style == "Dark" else (0.10, 0.32, 0.82, 0.35)

                        Line:

                            rounded_rectangle: self.x, self.y, self.width, self.height, 20

                            width: 1.2


                    BoxLayout:

                        orientation: "vertical"

                        padding: "18dp"

                        spacing: "7dp"


                        # =========================================
                        # AI HEADER
                        # =========================================

                        BoxLayout:

                            size_hint_y: None

                            height: "32dp"

                            spacing: "8dp"


                            Label:

                                text: "🤖"

                                font_size: "20sp"

                                size_hint_x: None

                                width: "30dp"

                                color: 1, 1, 1, 1


                            Label:

                                text: "AI Financial Advisor"

                                font_size: "18sp"

                                bold: True

                                color: (0.30, 0.60, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.10, 0.32, 0.82, 1)

                                halign: "left"

                                valign: "middle"

                                text_size: self.size


                            Label:

                                id: ai_priority

                                text: "INFO"

                                font_size: "10sp"

                                bold: True

                                color: (0.30, 0.60, 1, 1)

                                halign: "right"

                                valign: "middle"

                                text_size: self.size

                                size_hint_x: 0.35


                        # =========================================
                        # AI TITLE
                        # =========================================

                        Label:

                            id: ai_title

                            text: "Start Tracking"

                            font_size: "15sp"

                            bold: True

                            color: (0.92, 0.92, 0.95, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.16, 0.20, 1)

                            halign: "left"

                            valign: "middle"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "25dp"


                        # =========================================
                        # AI MESSAGE
                        # =========================================

                        Label:

                            id: insight_message

                            text: "Start adding transactions to receive personalised financial recommendations."

                            font_size: "13sp"

                            color: (0.75, 0.77, 0.82, 1) if app.theme_cls.theme_style == "Dark" else (0.28, 0.30, 0.36, 1)

                            halign: "left"

                            valign: "top"

                            text_size: self.width, None

                            size_hint_y: None

                            height: self.texture_size[1]


                        Widget:

                            size_hint_y: 1


                # =================================================
                # EXPENSE BREAKDOWN
                # =================================================

                MDCard:

                    size_hint_y: None

                    height: "430dp"

                    radius: [20, 20, 20, 20]

                    elevation: 3

                    md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                    BoxLayout:

                        orientation: "vertical"

                        padding: "16dp"

                        spacing: "8dp"


                        Label:

                            text: "Expense Breakdown"

                            font_size: "20sp"

                            bold: True

                            color: (0.95, 0.95, 0.97, 1) if app.theme_cls.theme_style == "Dark" else (0.12, 0.14, 0.20, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "30dp"


                        Label:

                            text: "See which categories take the biggest share"

                            font_size: "12sp"

                            color: (0.60, 0.62, 0.68, 1) if app.theme_cls.theme_style == "Dark" else (0.45, 0.48, 0.55, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "22dp"


                        Image:

                            id: expense_chart

                            source: "assets/expense_chart.png"

                            allow_stretch: True

                            keep_ratio: True

                            size_hint_y: 1


                # =================================================
                # INCOME VS EXPENSE
                # =================================================

                MDCard:

                    size_hint_y: None

                    height: "390dp"

                    radius: [20, 20, 20, 20]

                    elevation: 3

                    md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                    BoxLayout:

                        orientation: "vertical"

                        padding: "16dp"

                        spacing: "8dp"


                        Label:

                            text: "Income vs Expenses"

                            font_size: "20sp"

                            bold: True

                            color: (0.95, 0.95, 0.97, 1) if app.theme_cls.theme_style == "Dark" else (0.12, 0.14, 0.20, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "30dp"


                        Image:

                            id: income_expense_chart

                            source: "assets/income_expense_chart.png"

                            allow_stretch: True

                            keep_ratio: True

                            size_hint_y: 1


                # =================================================
                # CATEGORY CHART
                # =================================================

                MDCard:

                    size_hint_y: None

                    height: "390dp"

                    radius: [20, 20, 20, 20]

                    elevation: 3

                    md_bg_color: (0.12, 0.13, 0.17, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                    BoxLayout:

                        orientation: "vertical"

                        padding: "16dp"

                        spacing: "8dp"


                        Label:

                            text: "Category Spending"

                            font_size: "20sp"

                            bold: True

                            color: (0.95, 0.95, 0.97, 1) if app.theme_cls.theme_style == "Dark" else (0.12, 0.14, 0.20, 1)

                            halign: "left"

                            text_size: self.width, None

                            size_hint_y: None

                            height: "30dp"


                        Image:

                            id: category_chart

                            source: "assets/category_chart.png"

                            allow_stretch: True

                            keep_ratio: True

                            size_hint_y: 1


                # =================================================
                # BOTTOM PADDING
                # =================================================

                Widget:

                    size_hint_y: None

                    height: "20dp"


        # =====================================================
        # BOTTOM NAVIGATION
        # =====================================================

        BottomNav:
            size_hint_y: None

            height: "64dp"

            current_screen: "analytics"