#:kivy 2.3.1

#:import dp kivy.metrics.dp
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextButton kivymd.uix.button.MDTextButton


# ============================================================
# LOGIN SCREEN
# ============================================================

<LoginScreen>:

    canvas.before:

        Color:
            rgba:
                (0.07, 0.08, 0.11, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.96, 0.97, 1, 1)

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:

        orientation: "vertical"

        padding:
            dp(30)

        spacing:
            dp(15)


        # ====================================================
        # TOP SPACE
        # ====================================================

        Widget:
            size_hint_y: 0.15


        # ====================================================
        # LOGIN TITLE
        # ====================================================

        Label:

            text: "Login"

            font_size: "34sp"

            bold: True

            color:
                (0.30, 0.60, 1, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.10, 0.32, 0.82, 1)

            halign: "center"

            valign: "middle"

            text_size:
                self.size

            size_hint_y: None

            height:
                dp(50)


        # ====================================================
        # SUBTITLE
        # ====================================================

        Label:

            text: "Welcome back to PocketPilot."

            font_size: "16sp"

            color:
                (0.70, 0.74, 0.82, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.30, 0.36, 0.48, 1)

            halign: "center"

            valign: "middle"

            text_size:
                self.size

            size_hint_y: None

            height:
                dp(35)


        # ====================================================
        # EMAIL
        # ====================================================

        TextInput:

            id: email_input

            hint_text: "Email"

            multiline: False

            size_hint_y: None

            height:
                dp(56)

            font_size:
                "16sp"

            # ------------------------------------------------
            # TYPED TEXT
            # ------------------------------------------------

            foreground_color:
                (0.95, 0.97, 1, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.08, 0.10, 0.14, 1)

            # ------------------------------------------------
            # HINT TEXT
            # ------------------------------------------------

            hint_text_color:
                (0.58, 0.62, 0.70, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.38, 0.42, 0.48, 1)

            # ------------------------------------------------
            # CURSOR
            # ------------------------------------------------

            cursor_color:
                (0.25, 0.55, 1, 1)

            # ------------------------------------------------
            # TEXT SELECTION
            # ------------------------------------------------

            selection_color:
                (0.20, 0.45, 0.90, 0.35)

            background_normal: ""

            background_active: ""

            background_color:
                (0.12, 0.14, 0.18, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (1, 1, 1, 1)

            padding:
                dp(16), dp(14)

            canvas.before:

                # --------------------------------------------
                # FIELD BACKGROUND
                # --------------------------------------------

                Color:
                    rgba:
                        (0.12, 0.14, 0.18, 1) \
                        if app.theme_cls.theme_style == "Dark" \
                        else (1, 1, 1, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius:
                        [dp(12), dp(12), dp(12), dp(12)]

                # --------------------------------------------
                # FIELD BORDER
                # --------------------------------------------

                Color:
                    rgba:
                        (0.25, 0.55, 1, 0.90) \
                        if self.focus \
                        else (
                        (0.30, 0.33, 0.40, 1) \
                        if app.theme_cls.theme_style == "Dark" \
                        else (0.78, 0.80, 0.85, 1)
                        )

                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(12)
                    width:
                        dp(1.5)


        # ====================================================
        # PASSWORD
        # ====================================================

        TextInput:

            id: password_input

            hint_text: "Password"

            multiline: False

            password: True

            size_hint_y: None

            height:
                dp(56)

            font_size:
                "16sp"

            # ------------------------------------------------
            # TYPED PASSWORD
            # ------------------------------------------------

            foreground_color:
                (0.95, 0.97, 1, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.08, 0.10, 0.14, 1)

            # ------------------------------------------------
            # HINT
            # ------------------------------------------------

            hint_text_color:
                (0.58, 0.62, 0.70, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.38, 0.42, 0.48, 1)

            cursor_color:
                (0.25, 0.55, 1, 1)

            selection_color:
                (0.20, 0.45, 0.90, 0.35)

            background_normal: ""

            background_active: ""

            background_color:
                (0.12, 0.14, 0.18, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (1, 1, 1, 1)

            padding:
                dp(16), dp(14)

            canvas.before:

                Color:
                    rgba:
                        (0.12, 0.14, 0.18, 1) \
                        if app.theme_cls.theme_style == "Dark" \
                        else (1, 1, 1, 1)

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius:
                        [dp(12), dp(12), dp(12), dp(12)]

                Color:
                    rgba:
                        (0.25, 0.55, 1, 0.90) \
                        if self.focus \
                        else (
                        (0.30, 0.33, 0.40, 1) \
                        if app.theme_cls.theme_style == "Dark" \
                        else (0.78, 0.80, 0.85, 1)
                        )

                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(12)
                    width:
                        dp(1.5)


        # ====================================================
        # LOGIN BUTTON
        # ====================================================

        MDRaisedButton:

            text: "Login"

            size_hint: None, None

            size:
                dp(220), dp(48)

            pos_hint:
                {"center_x": 0.5}

            md_bg_color:
                0.10, 0.32, 0.82, 1

            text_color:
                1, 1, 1, 1

            elevation:
                3

            on_release:
                root.login()


        # ====================================================
        # SPACE
        # ====================================================

        Widget:

            size_hint_y: 0.05


        # ====================================================
        # SIGNUP MESSAGE
        # ====================================================

        Label:

            text: "Don't have an account?"

            color:
                (0.72, 0.75, 0.82, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.25, 0.25, 0.30, 1)

            font_size:
                "14sp"

            halign: "center"

            valign: "middle"

            text_size:
                self.size

            size_hint_y: None

            height:
                dp(30)


        # ====================================================
        # CREATE ACCOUNT
        # ====================================================

        MDTextButton:

            text: "Create Account"

            pos_hint:
                {"center_x": 0.5}

            theme_text_color:
                "Custom"

            text_color:
                (0.30, 0.60, 1, 1) \
                if app.theme_cls.theme_style == "Dark" \
                else (0.10, 0.32, 0.82, 1)

            on_release:
                root.go_to_signup()


        # ====================================================
        # BOTTOM SPACE
        # ====================================================

        Widget:

            size_hint_y: 0.2