#:kivy 2.3.1
#:import MDCard kivymd.uix.card.MDCard
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import BottomNav widget.bottom_nav.BottomNav

<HomeScreen>:

    canvas.before:
        Color:
            rgba: (0.10, 0.10, 0.10, 1) if app.theme_cls.theme_style == "Dark" else (0.96, 0.97, 1, 1)

        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"

        # ==========================================================
        # SCROLLABLE CONTENT
        # ==========================================================

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "16dp"

                # ==================================================
                # HEADER
                # ==================================================

                MDCard:
                    size_hint_y: None
                    height: "205dp"
                    radius: [0, 0, 28, 28]
                    elevation: 0
                    md_bg_color: 0.10, 0.32, 0.82, 1

                    BoxLayout:
                        orientation: "vertical"
                        padding: "25dp"
                        spacing: "5dp"

                        Label:
                            text: "PocketPilot"
                            font_size: "30sp"
                            bold: True
                            color: 1, 1, 1, 1
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: "45dp"

                        Widget:
                            size_hint_y: 0.25

                        Label:
                            text: "Welcome back,"
                            font_size: "17sp"
                            color: 0.90, 0.93, 1, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: "30dp"

                        Label:
                            text: root.user_name
                            font_size: "28sp"
                            bold: True
                            color: 1, 1, 1, 1
                            halign: "left"
                            valign: "middle"
                            text_size: self.width, None
                            size_hint_y: None
                            height: "40dp"

                        Widget:
                            size_hint_y: 0.1

                # ==================================================
                # BODY
                # ==================================================

                BoxLayout:
                    orientation: "vertical"
                    padding: "18dp", "16dp", "18dp", "20dp"
                    spacing: "16dp"
                    size_hint_y: None
                    height: self.minimum_height

                    # ==================================================
                    # CURRENT BALANCE
                    # ==================================================

                    MDCard:
                        orientation: "vertical"
                        size_hint_y: None
                        height: "145dp"
                        radius: [18]
                        elevation: 3
                        padding: "20dp"
                        spacing: "5dp"
                        md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        Label:
                            text: "Current Balance"
                            font_size: "18sp"
                            bold: True
                            color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.30, 0.30, 0.30, 1)
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: "30dp"

                        Label:
                            text: root.balance
                            font_size: "40sp"
                            bold: True
                            color: 0.05, 0.65, 0.20, 1
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: "60dp"

                    # ==================================================
                    # SAVINGS GOAL
                    # ==================================================

                    MDCard:
                        orientation: "vertical"
                        size_hint_y: None
                        height: "230dp"
                        radius: [18]
                        elevation: 3
                        padding: "18dp"
                        spacing: "7dp"
                        md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        Label:
                            text: "Savings Goal"
                            font_size: "20sp"
                            bold: True
                            color: 0.10, 0.32, 0.82, 1
                            halign: "center"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: "32dp"

                        Label:
                            text: root.goal_progress
                            font_size: "16sp"
                            color: (0.85, 0.85, 0.85, 1) if app.theme_cls.theme_style == "Dark" else (0.45, 0.45, 0.45, 1)
                            halign: "center"
                            text_size: self.size
                            size_hint_y: None
                            height: "28dp"

                        ProgressBar:
                            id: goal_progress_bar
                            max: 100
                            value: root.goal_percentage
                            size_hint_y: None
                            height: "10dp"

                        Label:
                            text: root.goal_percentage_text
                            font_size: "17sp"
                            bold: True
                            color: 0.05, 0.65, 0.20, 1
                            halign: "center"
                            text_size: self.size
                            size_hint_y: None
                            height: "28dp"

                        Label:
                            text: root.goal_remaining
                            font_size: "15sp"
                            color: (0.75, 0.75, 0.75, 1) if app.theme_cls.theme_style == "Dark" else (0.45, 0.45, 0.45, 1)
                            halign: "center"
                            text_size: self.size
                            size_hint_y: None
                            height: "25dp"

                        MDRaisedButton:
                            text: "Set Goal"
                            size_hint: None, None
                            size: "150dp", "40dp"
                            pos_hint: {"center_x": 0.5}
                            md_bg_color: 0.10, 0.32, 0.82, 1
                            text_color: 1, 1, 1, 1
                            on_release:
                                root.open_goal_popup()

                    # ==================================================
                    # ACTION BUTTONS
                    # ==================================================

                    BoxLayout:
                        spacing: "12dp"
                        size_hint_y: None
                        height: "50dp"

                        MDRaisedButton:
                            text: "+ Income"
                            size_hint_x: 0.5
                            md_bg_color: 0.05, 0.65, 0.20, 1
                            text_color: 1, 1, 1, 1
                            on_release:
                                root.open_income()

                        MDRaisedButton:
                            text: "+ Expense"
                            size_hint_x: 0.5
                            md_bg_color: 0.10, 0.32, 0.82, 1
                            text_color: 1, 1, 1, 1
                            on_release:
                                root.open_expense()

                    # ==================================================
                    # INCOME & EXPENSE
                    # ==================================================

                    BoxLayout:
                        spacing: "12dp"
                        size_hint_y: None
                        height: "105dp"

                        MDCard:
                            radius: [16]
                            elevation: 2
                            md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                            BoxLayout:
                                orientation: "vertical"
                                padding: "15dp"
                                spacing: "5dp"

                                Label:
                                    text: "Income"
                                    font_size: "15sp"
                                    bold: True
                                    color: (0.85, 0.85, 0.85, 1) if app.theme_cls.theme_style == "Dark" else (0.40, 0.40, 0.40, 1)
                                    halign: "center"
                                    text_size: self.size

                                Label:
                                    text: root.income
                                    font_size: "24sp"
                                    bold: True
                                    color: 0.05, 0.70, 0.05, 1
                                    halign: "center"
                                    text_size: self.size

                        MDCard:
                            radius: [16]
                            elevation: 2
                            md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                            BoxLayout:
                                orientation: "vertical"
                                padding: "15dp"
                                spacing: "5dp"

                                Label:
                                    text: "Expense"
                                    font_size: "15sp"
                                    bold: True
                                    color: (0.85, 0.85, 0.85, 1) if app.theme_cls.theme_style == "Dark" else (0.40, 0.40, 0.40, 1)
                                    halign: "center"
                                    text_size: self.size

                                Label:
                                    text: root.expense
                                    font_size: "24sp"
                                    bold: True
                                    color: 0.80, 0.05, 0.05, 1
                                    halign: "center"
                                    text_size: self.size

                    # ==================================================
                    # RECENT TRANSACTIONS
                    # ==================================================

                    Label:
                        text: "Recent Transactions"
                        font_size: "21sp"
                        bold: True
                        color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.15, 0.15, 1)
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: "35dp"

                    MDCard:
                        size_hint_y: None
                        height: "110dp"
                        radius: [16]
                        elevation: 2
                        padding: "15dp"
                        md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

                        Label:
                            text: root.recent_transaction
                            font_size: "16sp"
                            color: (0.85, 0.85, 0.85, 1) if app.theme_cls.theme_style == "Dark" else (0.50, 0.50, 0.50, 1)
                            halign: "center"
                            valign: "middle"
                            text_size: self.size

                    Widget:
                        size_hint_y: None
                        height: "15dp"

        # ==========================================================
        # BOTTOM NAVIGATION
        # ==========================================================

        BottomNav: