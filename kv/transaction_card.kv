#:kivy 2.3.1

#:import MDIcon kivymd.uix.label.MDIcon
#:import MDIconButton kivymd.uix.button.MDIconButton

<TransactionCard>:

    size_hint_y: None
    height: "120dp"

    radius: [18]
    elevation: 2
    padding: "18dp"

    md_bg_color: (0.16, 0.16, 0.16, 1) if app.theme_cls.theme_style == "Dark" else (1, 1, 1, 1)

    BoxLayout:
        spacing: "15dp"

        # ==========================
        # Transaction Icon
        # ==========================
        MDIcon:
            icon: root.icon
            font_size: "30sp"
            theme_text_color: "Custom"
            text_color: root.amount_color
            size_hint_x: None
            width: "40dp"

        # ==========================
        # Transaction Details
        # ==========================
        BoxLayout:
            orientation: "vertical"

            BoxLayout:
                size_hint_y: None
                height: "28dp"

                Label:
                    text: root.category
                    bold: True
                    font_size: "20sp"
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (.15, .15, .15, 1)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Label:
                    text: root.amount
                    bold: True
                    font_size: "21sp"
                    color: root.amount_color
                    halign: "right"
                    valign: "middle"
                    text_size: self.size

            Label:
                text: root.description
                font_size: "15sp"
                color: (.82, .82, .82, 1) if app.theme_cls.theme_style == "Dark" else (.45, .45, .45, 1)
                halign: "left"
                text_size: self.size

            Label:
                text: root.date
                font_size: "13sp"
                color: (.65, .65, .65, 1) if app.theme_cls.theme_style == "Dark" else (.60, .60, .60, 1)
                halign: "left"
                text_size: self.size

        # ==========================
        # Action Buttons
        # ==========================
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: "45dp"
            spacing: "5dp"

            Widget:

            MDIconButton:
                icon: "pencil"
                theme_text_color: "Custom"
                text_color: 0.10, 0.32, 0.82, 1

                on_release:
                    app.root.get_screen("history").edit_transaction(root.transaction_id)

            MDIconButton:
                icon: "delete"
                theme_text_color: "Custom"
                text_color: 0.85, 0, 0, 1

                on_release:
                    app.root.get_screen("history").confirm_delete(root.transaction_id)