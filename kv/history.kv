#:kivy 2.3.1

#:import MDCard kivymd.uix.card.MDCard
#:import BottomNav widget.bottom_nav.BottomNav


<HistoryScreen>:

    BoxLayout:
        orientation: "vertical"

        # =====================================================
        # BACKGROUND
        # =====================================================

        canvas.before:
            Color:
                rgba: (0.07, 0.07, 0.09, 1) if app.theme_cls.theme_style == "Dark" else (0.96, 0.97, 1, 1)

            Rectangle:
                pos: self.pos
                size: self.size


        # =====================================================
        # MODERN HEADER
        # =====================================================

        MDCard:
            size_hint_y: None
            height: "125dp"

            radius: [0, 0, 28, 28]
            elevation: 0

            md_bg_color: 0.10, 0.32, 0.82, 1

            padding: "24dp", "18dp"


            BoxLayout:
                orientation: "vertical"
                spacing: "3dp"


                Label:
                    text: "Transaction History"

                    font_size: "28sp"
                    bold: True

                    color: 1, 1, 1, 1

                    halign: "left"
                    valign: "middle"

                    text_size: self.size


                Label:
                    text: "Keep track of your income and expenses"

                    font_size: "14sp"

                    color: 0.86, 0.91, 1, 1

                    halign: "left"
                    valign: "middle"

                    text_size: self.size


        # =====================================================
        # CONTENT
        # =====================================================

        ScrollView:

            do_scroll_x: False
            bar_width: "4dp"

            GridLayout:
                id: transaction_container

                cols: 1

                spacing: "10dp"

                padding: "14dp", "16dp", "14dp", "20dp"

                size_hint_y: None
                height: self.minimum_height


        # =====================================================
        # BOTTOM NAVIGATION
        # =====================================================

        BottomNav:
            size_hint_y: None
            height: "72dp"