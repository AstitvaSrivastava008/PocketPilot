#:kivy 2.3.1
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextButton kivymd.uix.button.MDTextButton

<SignupScreen>:

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1

        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "30dp"
        spacing: "15dp"

        # ==========================================
        # TOP SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.12

        # ==========================================
        # TITLE
        # ==========================================

        Label:
            text: "Create Account"
            font_size: "34sp"
            bold: True
            color: 0.1, 0.2, 0.6, 1
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: "50dp"

        # ==========================================
        # FULL NAME
        # ==========================================

        TextInput:
            id: name_input
            hint_text: "Full Name"
            multiline: False

            size_hint_y: None
            height: "45dp"

            background_normal: ""
            background_active: ""
            background_color: 0.96, 0.97, 1, 1

            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1

            padding: "12dp", "10dp"

            cursor_color: 0.1, 0.2, 0.6, 1

            canvas.before:
                Color:
                    rgba: 0.55, 0.55, 0.55, 1

                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1

        # ==========================================
        # EMAIL
        # ==========================================

        TextInput:
            id: email_input
            hint_text: "Email"
            multiline: False

            size_hint_y: None
            height: "45dp"

            background_normal: ""
            background_active: ""
            background_color: 0.96, 0.97, 1, 1

            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1

            padding: "12dp", "10dp"

            cursor_color: 0.1, 0.2, 0.6, 1

            canvas.before:
                Color:
                    rgba: 0.55, 0.55, 0.55, 1

                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1

        # ==========================================
        # PASSWORD
        # ==========================================

        TextInput:
            id: password_input
            hint_text: "Password"
            multiline: False
            password: True

            size_hint_y: None
            height: "45dp"

            background_normal: ""
            background_active: ""
            background_color: 0.96, 0.97, 1, 1

            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1

            padding: "12dp", "10dp"

            cursor_color: 0.1, 0.2, 0.6, 1

            canvas.before:
                Color:
                    rgba: 0.55, 0.55, 0.55, 1

                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1

        # ==========================================
        # CONFIRM PASSWORD
        # ==========================================

        TextInput:
            id: confirm_password_input
            hint_text: "Confirm Password"
            multiline: False
            password: True

            size_hint_y: None
            height: "45dp"

            background_normal: ""
            background_active: ""
            background_color: 0.96, 0.97, 1, 1

            foreground_color: 0, 0, 0, 1
            hint_text_color: 0.45, 0.45, 0.45, 1

            padding: "12dp", "10dp"

            cursor_color: 0.1, 0.2, 0.6, 1

            canvas.before:
                Color:
                    rgba: 0.55, 0.55, 0.55, 1

                Line:
                    rectangle: self.x, self.y, self.width, self.height
                    width: 1

        # ==========================================
        # CREATE ACCOUNT BUTTON
        # ==========================================

        MDRaisedButton:
            text: "Create Account"

            size_hint: None, None
            size: "220dp", "45dp"

            pos_hint: {"center_x": 0.5}

            md_bg_color: 0.1, 0.2, 0.6, 1
            text_color: 1, 1, 1, 1

            on_release:
                root.create_account()

        # ==========================================
        # SMALL SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.03

        # ==========================================
        # LOGIN MESSAGE
        # ==========================================

        Label:
            text: "Already have an account?"
            color: 0.3, 0.3, 0.3, 1
            font_size: "14sp"

            halign: "center"
            valign: "middle"
            text_size: self.size

            size_hint_y: None
            height: "30dp"

        # ==========================================
        # LOGIN BUTTON
        # ==========================================

        MDTextButton:
            text: "Login"

            pos_hint: {"center_x": 0.5}

            theme_text_color: "Custom"
            text_color: 0.1, 0.2, 0.6, 1

            on_release:
                app.root.current = "login"

        # ==========================================
        # BOTTOM SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.15