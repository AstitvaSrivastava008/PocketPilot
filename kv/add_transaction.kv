#:kivy 2.3.1
#:import MDCard kivymd.uix.card.MDCard
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton

<AddTransactionScreen>:

    BoxLayout:
        orientation: "vertical"

        canvas.before:
            Color:
                rgba: (0.10, 0.10, 0.10, 1) if app.theme_cls.theme_style == "Dark" else (0.96, 0.97, 1, 1)

            Rectangle:
                pos: self.pos
                size: self.size

        # ======================================
        # HEADER
        # ======================================

        MDCard:
            size_hint_y: None
            height: "120dp"
            radius: [0, 0, 30, 30]
            elevation: 0
            md_bg_color: 0.10, 0.32, 0.82, 1

            BoxLayout:
                orientation: "vertical"
                padding: "20dp"

                Label:
                    text: "Edit Transaction" if root.edit_mode else "Add Transaction"
                    font_size: "30sp"
                    bold: True
                    color: 1, 1, 1, 1

                Label:
                    text: "Record your income or expense"
                    font_size: "16sp"
                    color: 0.9, 0.9, 1, 1

        # ======================================
        # FORM
        # ======================================

        ScrollView:
            do_scroll_x: False

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: "20dp"
                spacing: "20dp"

                # ======================================
                # TRANSACTION TYPE
                # ======================================

                Label:
                    text: "Transaction Type"
                    font_size: "18sp"
                    bold: True
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.15, 0.15, 1)
                    size_hint_y: None
                    height: "30dp"

                BoxLayout:
                    spacing: "15dp"
                    size_hint_y: None
                    height: "50dp"

                    ToggleButton:
                        id: income_toggle
                        text: "Income"
                        background_normal: ""
                        background_down: ""
                        background_color: (0.20, 0.20, 0.20, 1) if app.theme_cls.theme_style == "Dark" else (0.85, 0.85, 0.85, 1)
                        color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0, 0, 0, 1)
                        group: "type"

                        on_state:
                            root.load_income_categories() if self.state == "down" else None

                    ToggleButton:
                        id: expense_toggle
                        text: "Expense"
                        group: "type"
                        state: "down"
                        background_normal: ""
                        background_down: ""
                        background_color: (0.20, 0.20, 0.20, 1) if app.theme_cls.theme_style == "Dark" else (0.85, 0.85, 0.85, 1)
                        color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0, 0, 0, 1)

                        on_state:
                            root.load_expense_categories() if self.state == "down" else None

                # ======================================
                # AMOUNT
                # ======================================

                Label:
                    text: "Amount"
                    font_size: "18sp"
                    bold: True
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.15, 0.15, 1)
                    size_hint_y: None
                    height: "25dp"

                TextInput:
                    id: amount_input
                    hint_text: "Enter amount"
                    multiline: False
                    input_filter: "float"

                    size_hint_y: None
                    height: "45dp"

                    background_normal: ""
                    background_active: ""

                    # Better visibility in Light Mode
                    background_color: (0.18, 0.18, 0.18, 1) if app.theme_cls.theme_style == "Dark" else (0.90, 0.92, 0.96, 1)
                    foreground_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.05, 0.05, 0.05, 1)
                    hint_text_color: (0.70, 0.70, 0.70, 1)

                    padding: "12dp", "10dp"

                    canvas.before:
                        Color:
                            rgba: (0.45, 0.45, 0.45, 1) if app.theme_cls.theme_style == "Dark" else (0.55, 0.55, 0.60, 1)

                        Line:
                            rectangle: self.x, self.y, self.width, self.height
                            width: 1.2

                # ======================================
                # CATEGORY
                # ======================================

                Label:
                    text: "Category"
                    font_size: "18sp"
                    bold: True
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.15, 0.15, 1)
                    size_hint_y: None
                    height: "25dp"

                Spinner:
                    id: category_spinner
                    text: "Select Category"
                    values: ()

                    size_hint_y: None
                    height: "45dp"

                    background_normal: ""
                    background_color: (0.18, 0.18, 0.18, 1) if app.theme_cls.theme_style == "Dark" else (0.90, 0.92, 0.96, 1)
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.05, 0.05, 0.05, 1)

                # ======================================
                # DESCRIPTION
                # ======================================

                Label:
                    text: "Description"
                    font_size: "18sp"
                    bold: True
                    color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.15, 0.15, 0.15, 1)
                    size_hint_y: None
                    height: "25dp"

                TextInput:
                    id: description_input
                    hint_text: "Optional"
                    multiline: True

                    size_hint_y: None
                    height: "100dp"

                    background_normal: ""
                    background_active: ""

                    # Better visibility in Light Mode
                    background_color: (0.18, 0.18, 0.18, 1) if app.theme_cls.theme_style == "Dark" else (0.90, 0.92, 0.96, 1)
                    foreground_color: (1, 1, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.05, 0.05, 0.05, 1)
                    hint_text_color: (0.70, 0.70, 0.70, 1)

                    padding: "12dp", "10dp"

                    canvas.before:
                        Color:
                            rgba: (0.45, 0.45, 0.45, 1) if app.theme_cls.theme_style == "Dark" else (0.55, 0.55, 0.60, 1)

                        Line:
                            rectangle: self.x, self.y, self.width, self.height
                            width: 1.2

                # ======================================
                # BUTTONS
                # ======================================

                BoxLayout:
                    spacing: "15dp"
                    size_hint_y: None
                    height: "50dp"

                    MDRaisedButton:
                        text: "Cancel"
                        md_bg_color: 0.55, 0.55, 0.55, 1
                        size_hint_x: 0.5

                        on_release:
                            root.edit_mode = False
                            root.clear_form()
                            app.root.current = "home"

                    MDRaisedButton:
                        id: save_button
                        text: "Update Transaction" if root.edit_mode else "Save Transaction"
                        md_bg_color: 0.10, 0.32, 0.82, 1
                        size_hint_x: 0.5

                        on_release:
                            root.save_transaction()

                Widget:
                    size_hint_y: None
                    height: "20dp"