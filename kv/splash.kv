#:kivy 2.3.1
#:import MDIcon kivymd.uix.label.MDIcon


<SplashScreen>:

    FloatLayout:

        # =====================================================
        # BACKGROUND
        # =====================================================

        canvas.before:
            Color:
                rgba: 0.95, 0.97, 1, 1

            Rectangle:
                pos: self.pos
                size: self.size


        # =====================================================
        # LOGO
        # =====================================================

        FloatLayout:
            id: logo_container

            size_hint: None, None
            size: "130dp", "130dp"

            pos_hint: {"center_x": 0.5, "center_y": 0.68}

            canvas.before:

                # Soft shadow
                Color:
                    rgba: 0.15, 0.15, 0.15, 0.18

                Ellipse:
                    pos: self.x - dp(5), self.y - dp(7)
                    size: self.width + dp(10), self.height + dp(10)

                # Blue circle
                Color:
                    rgba: 0.10, 0.32, 0.82, 1

                Ellipse:
                    pos: self.pos
                    size: self.size


            # =================================================
            # WALLET ICON
            # =================================================

            MDIcon:
                icon: "wallet-outline"

                size_hint: None, None
                size: "75dp", "75dp"

                pos_hint: {"center_x": 0.5, "center_y": 0.5}

                font_size: "65sp"

                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1

                halign: "center"
                valign: "middle"

                text_size: self.size


        # =====================================================
        # POCKETPILOT TITLE
        # =====================================================

        Label:
            text: "PocketPilot"

            font_size: "40sp"
            bold: True

            color: 0.10, 0.22, 0.55, 1

            size_hint: 0.9, None
            height: "55dp"

            pos_hint: {"center_x": 0.5, "center_y": 0.49}

            halign: "center"
            valign: "middle"

            text_size: self.size


        # =====================================================
        # TAGLINE
        # =====================================================

        Label:
            text: "Your money. Your journey. Your control."

            font_size: "16sp"

            color: 0.35, 0.42, 0.55, 1

            size_hint: 0.9, None
            height: "30dp"

            pos_hint: {"center_x": 0.5, "center_y": 0.425}

            halign: "center"
            valign: "middle"

            text_size: self.size


        # =====================================================
        # BOTTOM TEXT
        # =====================================================

        Label:
            text: "Smart Personal Finance"

            font_size: "13sp"

            color: 0.55, 0.60, 0.70, 1

            size_hint: 0.9, None
            height: "25dp"

            pos_hint: {"center_x": 0.5, "center_y": 0.09}

            halign: "center"
            valign: "middle"

            text_size: self.size