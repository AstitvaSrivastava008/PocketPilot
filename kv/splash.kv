#:kivy 2.3.1

<SplashScreen>:
    canvas.before:
        Color:
            rgba: 0.95, 0.97, 1, 1

        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "PocketPilot"
        font_size: "40sp"
        bold: True
        color: 0.1, 0.2, 0.6, 1

        size_hint: 1, 1
        halign: "center"
        valign: "middle"
        text_size: self.size