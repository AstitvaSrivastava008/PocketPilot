#:kivy 2.3.1

#:import dp kivy.metrics.dp


<ReceiptScreen>:

    canvas.before:

        Color:
            rgba: 0.055, 0.06, 0.09, 1

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:

        orientation: "vertical"

        spacing: dp(8)

        padding: dp(12)


        # =====================================================
        # HEADER
        # =====================================================

        BoxLayout:

            orientation: "vertical"

            size_hint_y: None

            height: dp(92)

            padding: dp(16), dp(10)

            spacing: dp(2)

            canvas.before:

                Color:
                    rgba: 0.10, 0.32, 0.82, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(18), dp(18), dp(18), dp(18)]


            Label:

                text: "Smart Transaction"

                color: 1, 1, 1, 1

                font_size: "24sp"

                bold: True

                halign: "left"

                valign: "middle"

                text_size: self.width, None


            Label:

                text: "Scan a receipt or payment screenshot"

                color: 0.88, 0.93, 1, 1

                font_size: "12sp"

                halign: "left"

                valign: "middle"

                text_size: self.width, None


        # =====================================================
        # STATUS
        # =====================================================

        Label:

            id: receipt_status

            text: "No receipt selected"

            color: 0.92, 0.94, 1, 1

            font_size: "15sp"

            bold: True

            size_hint_y: None

            height: dp(27)

            halign: "center"

            valign: "middle"

            text_size: self.width, None


        # =====================================================
        # RECEIPT IMAGE
        # =====================================================

        BoxLayout:

            size_hint_y: None

            height: dp(190)

            padding: dp(6)

            canvas.before:

                Color:
                    rgba: 0.12, 0.14, 0.19, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(14), dp(14), dp(14), dp(14)]


            Image:

                id: receipt_image

                source: ""

                allow_stretch: True

                keep_ratio: True


        # =====================================================
        # INSTRUCTION
        # =====================================================

        Label:

            id: instruction_label

            text: "Choose a receipt from the PocketPilot receipt folder."

            color: 0.70, 0.75, 0.84, 1

            font_size: "12sp"

            size_hint_y: None

            height: dp(30)

            halign: "center"

            valign: "middle"

            text_size: self.width - dp(20), None


        # =====================================================
        # ACTION BUTTONS
        # =====================================================

        BoxLayout:

            size_hint_y: None

            height: dp(46)

            spacing: dp(8)


            Button:

                text: "Select Receipt / Screenshot"

                font_size: "13sp"

                bold: True

                color: 1, 1, 1, 1

                background_normal: ""

                background_color: 0.10, 0.38, 0.88, 1

                on_release:

                    root.select_receipt()


            Button:

                id: process_button

                text: "Process Receipt"

                font_size: "13sp"

                bold: True

                disabled: True

                color: 1, 1, 1, 1

                background_normal: ""

                background_color: 0.05, 0.65, 0.28, 1

                on_release:

                    root.process_receipt()


        # =====================================================
        # EXTRACTED TRANSACTION AREA
        #
        # IMPORTANT:
        # This has its own fixed area so it cannot disappear
        # because of BoxLayout size calculations.
        # =====================================================

        BoxLayout:

            id: extracted_card

            orientation: "vertical"

            size_hint_y: 1

            padding: dp(2)

            opacity: 0

            disabled: True


            canvas.before:

                Color:
                    rgba: 0.12, 0.14, 0.20, 1

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15), dp(15), dp(15), dp(15)]

                Color:
                    rgba: 0.10, 0.38, 0.88, 1

                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(15)

                    width: dp(1.2)


            # -------------------------------------------------
            # SCROLLABLE CONTENT
            # -------------------------------------------------

            ScrollView:

                do_scroll_x: False

                do_scroll_y: True

                bar_width: dp(5)


                BoxLayout:

                    orientation: "vertical"

                    size_hint_y: None

                    height: self.minimum_height

                    padding: dp(14)

                    spacing: dp(4)


                    # =========================================
                    # TITLE
                    # =========================================

                    Label:

                        text: "Extracted Transaction"

                        color: 0.35, 0.68, 1, 1

                        font_size: "18sp"

                        bold: True

                        size_hint_y: None

                        height: dp(27)

                        halign: "left"

                        valign: "middle"

                        text_size: self.width, None


                    Label:

                        text: "Review the information before saving."

                        color: 0.65, 0.70, 0.80, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(21)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # MERCHANT
                    # =========================================

                    Label:

                        text: "Merchant"

                        color: 0.55, 0.61, 0.72, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(17)

                        halign: "left"

                        text_size: self.width, None


                    Label:

                        id: merchant_value

                        text: "-"

                        color: 1, 1, 1, 1

                        font_size: "14sp"

                        bold: True

                        size_hint_y: None

                        height: dp(22)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # AMOUNT
                    # =========================================

                    Label:

                        text: "Amount"

                        color: 0.55, 0.61, 0.72, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(17)

                        halign: "left"

                        text_size: self.width, None


                    Label:

                        id: amount_value

                        text: "-"

                        color: 0.15, 0.90, 0.42, 1

                        font_size: "19sp"

                        bold: True

                        size_hint_y: None

                        height: dp(27)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # DATE
                    # =========================================

                    Label:

                        id: date_value

                        text: "Date: -"

                        color: 0.92, 0.94, 0.98, 1

                        font_size: "12sp"

                        size_hint_y: None

                        height: dp(20)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # TIME
                    # =========================================

                    Label:

                        id: time_value

                        text: "Time: -"

                        color: 0.92, 0.94, 0.98, 1

                        font_size: "12sp"

                        size_hint_y: None

                        height: dp(20)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # TYPE
                    # =========================================

                    Label:

                        id: type_value

                        text: "Type: Expense"

                        color: 1, 0.75, 0.25, 1

                        font_size: "12sp"

                        bold: True

                        size_hint_y: None

                        height: dp(20)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # CATEGORY
                    # =========================================

                    Label:

                        text: "Category"

                        color: 0.55, 0.61, 0.72, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(17)

                        halign: "left"

                        text_size: self.width, None


                    Label:

                        id: category_value

                        text: "-"

                        color: 0.35, 0.68, 1, 1

                        font_size: "13sp"

                        bold: True

                        size_hint_y: None

                        height: dp(21)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # DESCRIPTION
                    # =========================================

                    Label:

                        text: "Description"

                        color: 0.55, 0.61, 0.72, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(17)

                        halign: "left"

                        text_size: self.width, None


                    Label:

                        id: description_value

                        text: "-"

                        color: 0.92, 0.94, 0.98, 1

                        font_size: "12sp"

                        size_hint_y: None

                        height: dp(22)

                        halign: "left"

                        valign: "middle"

                        text_size: self.width, None


                    # =========================================
                    # PAYMENT
                    # =========================================

                    Label:

                        id: payment_value

                        text: "Payment Method: -"

                        color: 0.85, 0.88, 0.95, 1

                        font_size: "12sp"

                        size_hint_y: None

                        height: dp(21)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # UPI ID
                    # =========================================

                    Label:

                        id: upi_value

                        text: "UPI ID: -"

                        color: 0.75, 0.80, 0.90, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(20)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # TRANSACTION ID
                    # =========================================

                    Label:

                        id: transaction_id_value

                        text: "Transaction ID: -"

                        color: 0.75, 0.80, 0.90, 1

                        font_size: "11sp"

                        size_hint_y: None

                        height: dp(20)

                        halign: "left"

                        text_size: self.width, None


                    # =========================================
                    # SAVE BUTTON
                    # =========================================

                    Button:

                        id: save_button

                        text: "✓  Confirm & Save Transaction"

                        font_size: "13sp"

                        bold: True

                        disabled: True

                        color: 1, 1, 1, 1

                        background_normal: ""

                        background_color: 0.05, 0.65, 0.28, 1

                        size_hint_y: None

                        height: dp(45)

                        on_release:

                            root.save_transaction()


                    # =========================================
                    # CLEAR BUTTON
                    # =========================================

                    Button:

                        text: "Clear Selected Image"

                        font_size: "11sp"

                        color: 0.35, 0.65, 1, 1

                        background_normal: ""

                        background_color: 0, 0, 0, 0

                        size_hint_y: None

                        height: dp(30)

                        on_release:

                            root.clear_receipt()


        # =====================================================
        # STATUS MESSAGE
        # =====================================================

        Label:

            id: status_label

            text: "Select a receipt or payment screenshot to begin."

            color: 0.72, 0.76, 0.84, 1

            font_size: "11sp"

            size_hint_y: None

            height: dp(25)

            halign: "center"

            valign: "middle"

            text_size: self.width - dp(20), None


        # =====================================================
        # BACK BUTTON
        # =====================================================

        Button:

            text: "←  Back to Add Transaction"

            font_size: "12sp"

            color: 0.65, 0.75, 1, 1

            background_normal: ""

            background_color: 0, 0, 0, 0

            size_hint_y: None

            height: dp(30)

            on_release:

                root.go_back()