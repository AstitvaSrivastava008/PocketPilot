#:kivy 2.3.1
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextButton kivymd.uix.button.MDTextButton


<WelcomeScreen>:

    # =========================================================
    # BACKGROUND
    # =========================================================

    canvas.before:
        Color:
            rgba: (0.10, 0.10, 0.10, 1) if app.theme_cls.theme_style == "Dark" else (0.95, 0.97, 1, 1)

        Rectangle:
            pos: self.pos
            size: self.size


    BoxLayout:
        orientation: "vertical"
        spacing: "15dp"
        padding: "40dp"


        # =====================================================
        # TOP SPACE
        # =====================================================

        Widget:
            size_hint_y: 0.15


        # =====================================================
        # POCKETPILOT LOGO
        # =====================================================

        Image:
            source: "assets/icons/p1.png"

            size_hint_y: None
            height: "180dp"

            allow_stretch: True
            keep_ratio: True


        # =====================================================
        # APP NAME
        # =====================================================

        Label:
            text: "PocketPilot"

            font_size: "34sp"
            bold: True

            color: (0.25, 0.55, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.10, 0.22, 0.55, 1)

            halign: "center"
            valign: "middle"

            text_size: self.size

            size_hint_y: None
            height: "50dp"


        # =====================================================
        # TAGLINE
        # =====================================================

        Label:
            text: "Take control of your money."

            font_size: "18sp"

            color: (0.75, 0.75, 0.78, 1) if app.theme_cls.theme_style == "Dark" else (0.30, 0.35, 0.45, 1)

            halign: "center"
            valign: "middle"

            text_size: self.size

            size_hint_y: None
            height: "40dp"


        # =====================================================
        # SPACE
        # =====================================================

        Widget:
            size_hint_y: 0.10


        # =====================================================
        # GET STARTED BUTTON
        # =====================================================

        MDRaisedButton:
            text: "Get Started"

            size_hint: None, None
            size: "220dp", "50dp"

            pos_hint: {"center_x": 0.5}

            md_bg_color: 0.10, 0.32, 0.82, 1
            text_color: 1, 1, 1, 1

            on_release:
                root.go_to_choice()


        # =====================================================
        # ACCOUNT MESSAGE
        # =====================================================

        Label:
            text: "Already have an account?"

            color: (0.65, 0.65, 0.68, 1) if app.theme_cls.theme_style == "Dark" else (0.50, 0.50, 0.50, 1)

            font_size: "14sp"

            halign: "center"
            valign: "middle"

            text_size: self.size

            size_hint_y: None
            height: "30dp"


        # =====================================================
        # LOGIN BUTTON
        # =====================================================

        MDTextButton:
            text: "Login"

            pos_hint: {"center_x": 0.5}

            theme_text_color: "Custom"

            text_color: (0.30, 0.60, 1, 1) if app.theme_cls.theme_style == "Dark" else (0.10, 0.22, 0.55, 1)

            on_release:
                root.go_to_login()


        # =====================================================
        # BOTTOM SPACE
        # =====================================================

        Widget:
            size_hint_y: 0.15