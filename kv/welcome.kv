#:kivy 2.3.1
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDTextButton kivymd.uix.button.MDTextButton

<WelcomeScreen>:

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1

        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        spacing: "15dp"
        padding: "40dp"

        # ==========================================
        # TOP SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.18

        # ==========================================
        # POCKETPILOT LOGO
        # ==========================================

        Image:
            source: "assets/icons/p1.png"
            size_hint_y: None
            height: "180dp"
            allow_stretch: True
            keep_ratio: True

        # ==========================================
        # APP NAME
        # ==========================================

        Label:
            text: "PocketPilot"
            font_size: "34sp"
            bold: True
            color: 0.1, 0.2, 0.6, 1
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: "50dp"

        # ==========================================
        # TAGLINE
        # ==========================================

        Label:
            text: "Take control of your money."
            font_size: "18sp"
            color: 0.3, 0.3, 0.3, 1
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: "40dp"

        # ==========================================
        # SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.12

        # ==========================================
        # GET STARTED BUTTON
        # ==========================================

        MDRaisedButton:
            text: "Get Started"
            size_hint: None, None
            size: "220dp", "50dp"
            pos_hint: {"center_x": 0.5}
            md_bg_color: 0.1, 0.2, 0.6, 1
            text_color: 1, 1, 1, 1

            on_release:
                root.go_to_choice()

        # ==========================================
        # ACCOUNT MESSAGE
        # ==========================================

        Label:
            text: "Already have an account?"
            color: 0.5, 0.5, 0.5, 1
            font_size: "14sp"
            halign: "center"
            valign: "middle"
            text_size: self.size
            size_hint_y: None
            height: "30dp"

        # ==========================================
        # LOGIN BUTTON
        # ==========================================

        MDTextButton:
            text: "Login"
            pos_hint: {"center_x": 0.5}
            theme_text_color: "Custom"
            text_color: 0.1, 0.2, 0.6, 1

            on_release:
                root.go_to_login()

        # ==========================================
        # BOTTOM SPACE
        # ==========================================

        Widget:
            size_hint_y: 0.15